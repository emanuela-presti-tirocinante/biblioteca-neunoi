{
    "name": "neunoi-library-app",
    "version": "1.0.0",
    "scripts": {
        "client": "npm run dev --prefix client",
        "server": "npm run dev --prefix server",
        "dev": "concurrently \"npm run server\" \"npm run client\"",
        "install:all": "npm install && npm install --prefix server && npm install --prefix client",
        "start": "node server/index.js"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.1.1",
        "node-cron": "^4.2.1",
        "nodemailer": "^8.0.1",
        "sequelize": "^6.32.1",
        "mysql2": "^3.11.3",
        "sqlite3": "^5.1.6",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "concurrently": "^8.2.0"
    }
}